<view class="page">
  <view class="form dt-card">
    <view class="row">
      <text class="label">联系人</text>
      <input class="val" data-k="consignee" value="{{form.consignee}}" bindinput="onInput" placeholder="收货人姓名" placeholder-class="ph" />
    </view>
    <view class="row">
      <text class="label">性别</text>
      <view class="seg">
        <text class="sg {{form.sex === '1' ? 'on' : ''}}" data-v="1" bindtap="onSex">先生</text>
        <text class="sg {{form.sex === '0' ? 'on' : ''}}" data-v="0" bindtap="onSex">女士</text>
      </view>
    </view>
    <view class="row">
      <text class="label">电话</text>
      <input class="val" type="number" maxlength="11" data-k="phone" value="{{form.phone}}" bindinput="onInput" placeholder="手机号码" placeholder-class="ph" />
    </view>
    <view class="row">
      <text class="label">所在地区</text>
      <picker mode="region" value="{{region}}" bindchange="onRegion">
        <view class="val region {{region.join('') ? '' : 'ph'}}">{{region.join(' ') || '请选择省市区'}}</view>
      </picker>
    </view>
    <view class="row">
      <text class="label">详细地址</text>
      <input class="val" data-k="detail" value="{{form.detail}}" bindinput="onInput" placeholder="街道、小区、楼栋门牌" placeholder-class="ph" />
    </view>
    <view class="row">
      <text class="label">标签</text>
      <view class="chips">
        <text class="chip {{form.label === item ? 'on' : ''}}" wx:for="{{labels}}" wx:key="*this" data-v="{{item}}" bindtap="onLabel">{{item}}</text>
      </view>
    </view>
    <view class="row">
      <text class="label">设为默认</text>
      <switch checked="{{form.isDefault === 1}}" color="#FF7A35" bindchange="onDefault" />
    </view>
  </view>

  <button class="dt-btn block save" bindtap="save" disabled="{{saving}}">{{saving ? '保存中…' : '保存'}}</button>
</view>