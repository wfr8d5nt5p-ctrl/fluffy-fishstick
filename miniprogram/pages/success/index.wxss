.page { min-height: 100vh; padding: 90rpx 40rpx 60rpx; display: flex; flex-direction: column; align-items: center; }
.ok {
  width: 130rpx; height: 130rpx; border-radius: 50%;
  background: linear-gradient(135deg, #2FB98A, #1f9c72); color: #fff;
  font-size: 70rpx; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(47,185,138,.35);
}
.title { margin-top: 30rpx; font-size: 40rpx; font-weight: 800; }
.sub { margin-top: 12rpx; font-size: 24rpx; color: var(--ink-2); }
.card { width: 100%; margin: 44rpx 0 34rpx; padding: 10rpx 30rpx; }
.row { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); font-size: 27rpx; }
.row:last-child { border: none; }
.k { color: var(--ink-2); }
.v { font-weight: 600; }
.home { margin-top: 28rpx; font-size: 26rpx; color: var(--muted); }