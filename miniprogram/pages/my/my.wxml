<view class="page">
  <view class="head">
    <image class="avatar" src="{{avatar}}" mode="aspectFill" />
    <view class="who">
      <text class="name">{{name}}</text>
      <text class="phone">{{phone || '欢迎来到ConeEats'}}</text>
    </view>
    <view class="edit" bindtap="edit">
      <text class="edit-ic">✎</text>
      <text class="edit-t">编辑资料</text>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="coupon-card" bindtap="coupon">
    <view class="coupon-ic">🎫</view>
    <view class="coupon-info">
      <text class="coupon-count">3张优惠券可用</text>
      <text class="coupon-desc">满30减8 · 有效期至10-31</text>
    </view>
    <view class="coupon-btn">去使用</view>
  </view>

  <view class="grid dt-card">
    <view class="cell" bindtap="orders">
      <view class="ic"><text>📋</text></view>
      <text class="ct">全部订单</text>
    </view>
    <view class="cell" bindtap="coupon">
      <view class="ic"><text>🎫</text></view>
      <text class="ct">优惠券</text>
    </view>
    <view class="cell" bindtap="address">
      <view class="ic"><text>📍</text></view>
      <text class="ct">收货地址</text>
    </view>
    <view class="cell" bindtap="service">
      <view class="ic"><text>🎧</text></view>
      <text class="ct">客服中心</text>
    </view>
    <view class="cell" bindtap="security">
      <view class="ic"><text>🛡️</text></view>
      <text class="ct">账号与安全</text>
    </view>
    <view class="cell" bindtap="about">
      <view class="ic"><text>💬</text></view>
      <text class="ct">关于我们</text>
    </view>
  </view>

  <view class="freq" wx:if="{{frequentStores.length}}">
    <view class="freq-head">
      <text class="freq-t">常点店铺</text>
      <view class="freq-all" bindtap="moreStores"><text>全部</text><text class="arrow">›</text></view>
    </view>
    <view class="freq-item" wx:for="{{frequentStores}}" wx:key="id">
      <image wx:if="{{item.img}}" class="fimg" src="{{item.img}}" mode="aspectFill" />
      <view wx:else class="fimg fph">蛋</view>
      <view class="fwho">
        <text class="fname">{{item.name}}</text>
        <text class="flast">{{item.last}}</text>
      </view>
      <view class="fbtn" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="goStore">再来一单</view>
    </view>
  </view>

  <button class="logout dt-card" bindtap="logout">退出登录</button>
  <view class="ver">ConeEats v2.0.0 · 最近登录 IP: {{ip || '127.0.0.1'}}</view>
</view>