.page { min-height: 100vh; padding: 20rpx 30rpx 200rpx; }
.addr { padding: 26rpx; margin-bottom: 18rpx; }
.addr-main { display: flex; align-items: center; gap: 14rpx; }
.addr-info { flex: 1; min-width: 0; }
.name-row { display: flex; align-items: center; gap: 14rpx; }
.name { font-size: 30rpx; font-weight: 800; }
.phone { font-size: 26rpx; color: var(--ink-2); }
.default { font-size: 20rpx; color: var(--brand); background: var(--brand-soft); padding: 2rpx 12rpx; border-radius: 6rpx; }
.detail { display: block; margin-top: 10rpx; font-size: 24rpx; color: var(--ink-2); line-height: 1.5; }
.radio {
  width: 40rpx; height: 40rpx; border-radius: 50%; border: 3rpx solid var(--line);
  color: transparent; display: flex; align-items: center; justify-content: center; font-size: 24rpx; flex-shrink: 0;
}
.radio.on { background: var(--brand); border-color: var(--brand); color: #fff; }
.addr-foot { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.set-default { font-size: 24rpx; color: var(--ink-2); display: flex; align-items: center; gap: 8rpx; }
.chk {
  width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid var(--line); color: transparent;
  display: inline-flex; align-items: center; justify-content: center; font-size: 20rpx;
}
.chk.on { background: var(--brand); border-color: var(--brand); color: #fff; }
.ops { display: flex; gap: 26rpx; }
.op { font-size: 24rpx; color: var(--ink); }
.op.del { color: #E6573C; }
.empty { text-align: center; color: var(--muted); padding: 80rpx 0; font-size: 26rpx; }
.bar {
  position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); background: var(--card);
  box-shadow: 0 -6rpx 24rpx rgba(0,0,0,.05);
}