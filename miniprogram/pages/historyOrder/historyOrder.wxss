.page { min-height: 100vh; }
.tabs {
  position: sticky; top: 0; z-index: 10; background: var(--card);
  display: flex; white-space: nowrap; padding: 20rpx 20rpx 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,.03);
}
.tab {
  display: inline-block; padding: 14rpx 30rpx; font-size: 27rpx; color: var(--ink-2); margin-right: 8rpx;
}
.tab.on { color: var(--brand); font-weight: 700; border-bottom: 6rpx solid var(--brand); }
.body { padding: 20rpx 30rpx; }
.card { padding: 26rpx; margin-bottom: 18rpx; }
.head { display: flex; justify-content: space-between; align-items: center; }
.time { font-size: 24rpx; color: var(--muted); }
.status {
  font-size: 24rpx; font-weight: 700; color: var(--ink-2);
  padding: 6rpx 20rpx; border-radius: 999rpx;
}
.status.s1 { color: #D9601F; background: #FFEAD9; }
.status.s2 { color: #2E7BC4; background: #E5F0FB; }
.status.s3 { color: #159E87; background: #DFF5EF; }
.status.s4 { color: #E08E1B; background: #FFF2DC; }
.status.s5 { color: #1F9E6C; background: #E4F7EE; }
.status.s6 { color: #E0573C; background: #FCECEA; }
.store { display: flex; align-items: center; gap: 14rpx; margin-top: 16rpx; }
.store-img { width: 46rpx; height: 46rpx; border-radius: 12rpx; background: var(--line); }
.store-img.initials { display: flex; align-items: center; justify-content: center; color: #fff; font-size: 26rpx; font-weight: 700; }
.store-name { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.mid { display: flex; justify-content: space-between; align-items: center; margin-top: 16rpx; }
.act { display: flex; justify-content: flex-end; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid var(--line); }
.btn { font-size: 26rpx; color: var(--brand); border: 1rpx solid var(--brand); padding: 8rpx 30rpx; border-radius: 999rpx; }
.no { font-size: 24rpx; color: var(--ink-2); }
.amount { font-size: 38rpx; font-weight: 800; color: var(--brand-deep); }
.amount .yen { font-size: 24rpx; }
.addr { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); font-size: 24rpx; color: var(--ink-2); }
.empty { text-align: center; color: var(--muted); padding: 100rpx 0; font-size: 26rpx; }
.empty.muted { color: var(--muted); }
.go {
  margin: 30rpx auto 0; width: 220rpx; padding: 18rpx 0; text-align: center;
  background: linear-gradient(90deg, var(--brand), var(--brand-deep)); color: #fff; border-radius: 999rpx; font-weight: 600;
}