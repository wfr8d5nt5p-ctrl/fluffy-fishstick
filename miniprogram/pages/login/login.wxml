<view class="page">
  <view class="brand">
    <image class="brand-logo" src="/static/logo.png" mode="aspectFill" />
    <view class="brand-title">ConeEats</view>
    <view class="brand-sub">登录后即可开始点餐</view>
  </view>

  <view class="card">
    <view class="field">
      <text class="f-icon">☏</text>
      <text class="f-pre">+86</text>
      <input class="input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="ph"
             value="{{phone}}" bindinput="onPhone" />
    </view>
    <view class="field">
      <text class="f-icon">❖</text>
      <input class="input" type="number" maxlength="6" placeholder="请输入验证码" placeholder-class="ph"
             value="{{code}}" bindinput="onCode" />
      <text class="getcode {{counting ? 'dis' : ''}}" bindtap="getCode">{{counting ? countdown + 's' : '获取验证码'}}</text>
    </view>
  </view>

  <button class="submit {{(loading || !agreed) ? 'dis' : ''}}" bindtap="submit" disabled="{{loading || !agreed}}">{{loading ? '登录中…' : '登录 / 注册'}}</button>

  <view class="divider"><view class="line"></view><text>其他登录方式</text><view class="line"></view></view>

  <button class="wxlogin" open-type="getPhoneNumber" bindgetphonenumber="wxLogin">
    <text class="wx-ic">💬</text> 微信一键登录
  </button>

  <view class="agree" bindtap="toggleAgree">
    <view class="check {{agreed ? 'on' : ''}}"><text wx:if="{{agreed}}">✓</text></view>
    <text class="agree-t">已阅读并同意</text>
    <text class="link">《用户协议》</text>
    <text>和</text>
    <text class="link">《隐私政策》</text>
    <text class="agree-t">，并同意授权ConeEats使用您的账号信息（如昵称、头像）</text>
  </view>
</view>