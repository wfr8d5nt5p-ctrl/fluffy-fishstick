.page { min-height: 100vh; padding: 80rpx 48rpx; background: #F5F5F5; box-sizing: border-box; }
.brand { display: flex; flex-direction: column; align-items: center; margin-bottom: 56rpx; }
.brand-logo { width: 132rpx; height: 132rpx; border-radius: 30rpx; }
.brand-title { margin-top: 24rpx; font-size: 44rpx; font-weight: 800; color: #2D241B; }
.brand-sub { margin-top: 10rpx; font-size: 26rpx; color: #A89383; }

.card { background: #fff; border-radius: 28rpx; padding: 8rpx 32rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,.06); }
.field { display: flex; align-items: center; padding: 34rpx 0; border-bottom: 1rpx solid #F0EFED; }
.field:last-child { border-bottom: none; }
.f-icon { font-size: 32rpx; color: #B7A79A; margin-right: 18rpx; }
.f-pre { font-size: 30rpx; color: #8A8A8A; margin-right: 16rpx; }
.input { flex: 1; font-size: 30rpx; color: #2A2018; }
.ph { color: #C8B6A6; }
.getcode { flex-shrink: 0; font-size: 24rpx; color: #B85C38; padding: 8rpx 20rpx; border: 1rpx solid #D98E6E; border-radius: 999rpx; }
.getcode.dis { color: #B5A397; border-color: #E7DACB; }

.submit { margin: 44rpx 24rpx 0; padding: 30rpx; background: #B85C38; color: #fff; font-size: 34rpx; font-weight: 700; border-radius: 999rpx; }
.submit::after { border: none; }
.submit.dis { opacity: .5; }

.divider { display: flex; align-items: center; gap: 20rpx; margin: 56rpx 0 30rpx; }
.divider .line { flex: 1; height: 1rpx; background: #E2DED8; }
.divider text { font-size: 24rpx; color: #A89383; }

.wxlogin {
  display: flex; align-items: center; justify-content: center; gap: 10rpx;
  width: 100%; padding: 28rpx; background: #07C160; color: #fff;
  font-size: 30rpx; font-weight: 700; border-radius: 999rpx;
}
.wxlogin::after { border: none; }
.wx-ic { font-size: 32rpx; }

.agree { display: flex; align-items: center; flex-wrap: wrap; justify-content: center; gap: 8rpx; margin-top: 30rpx; font-size: 24rpx; color: #8A7461; }
.check {
  width: 30rpx; height: 30rpx; border-radius: 50%; border: 2rpx solid #C9B6A4;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #fff; box-sizing: border-box;
}
.check.on { background: #B85C38; border-color: #B85C38; }
.link { color: #B85C38; }